<?xml version="1.0"?>
<Definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Sounds>
        <!--
            Distant cues: each weapon reuses its own near wave for the distant bands.
            The engine fades volume out toward each cue's MaxDistance, and the
            JSDistantMuffle / JSFarDistantMuffle low-pass effects (AudioEffects.sbc)
            cut the highs so it sounds far away.
        -->

        <!-- ===================== Gatling (fixed gun) ===================== -->
        <Sound>
            <Id>
                <TypeId>MyObjectBuilder_AudioDefinition</TypeId>
                <SubtypeId>ArcWepShipGatlingShot</SubtypeId>
            </Id>
            <Category>SHOT</Category>
            <MaxDistance>200</MaxDistance>
            <PreventSynchronization>0</PreventSynchronization>
            <DynamicMusicCategory>HeavyFight</DynamicMusicCategory>
            <DynamicMusicAmount>3</DynamicMusicAmount>
            <DistantSounds>
                <DistantSound DistanceCrossfade="10" Distance="200" Sound="JSWepGatlingShotDist" />
            </DistantSounds>
            <Volume>1.5</Volume>
            <Waves>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling01.wav</Start>
                </Wave>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling02.wav</Start>
                </Wave>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling03.wav</Start>
                </Wave>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling04.wav</Start>
                </Wave>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling05.wav</Start>
                </Wave>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling06.wav</Start>
                </Wave>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling07.wav</Start>
                </Wave>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling08.wav</Start>
                </Wave>
            </Waves>
        </Sound>

        <!-- ===================== Gatling (turrets) ===================== -->
        <Sound>
            <Id>
                <TypeId>MyObjectBuilder_AudioDefinition</TypeId>
                <SubtypeId>ArcWepGatlingTurretShot</SubtypeId>
            </Id>
            <Category>SHOT</Category>
            <MaxDistance>230</MaxDistance>
            <PreventSynchronization>0</PreventSynchronization>
            <DynamicMusicCategory>HeavyFight</DynamicMusicCategory>
            <DynamicMusicAmount>3</DynamicMusicAmount>
            <DistantSounds>
                <DistantSound DistanceCrossfade="10" Distance="230" Sound="JSWepGatlingShotDist" />
            </DistantSounds>
            <Volume>1.5</Volume>
            <Waves>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling01.wav</Start>
                </Wave>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling02.wav</Start>
                </Wave>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling03.wav</Start>
                </Wave>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling04.wav</Start>
                </Wave>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling05.wav</Start>
                </Wave>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling06.wav</Start>
                </Wave>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling07.wav</Start>
                </Wave>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling08.wav</Start>
                </Wave>
            </Waves>
        </Sound>
        <Sound>
            <Id>
                <TypeId>MyObjectBuilder_AudioDefinition</TypeId>
                <SubtypeId>JSWepGatlingShotDist</SubtypeId>
            </Id>
            <Category>SHOT</Category>
            <MaxDistance>800</MaxDistance>
            <PreventSynchronization>0</PreventSynchronization>
            <ArcadeFilter>JSDistantMuffle</ArcadeFilter>
            <Volume>0.75</Volume>
            <Waves>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling01.wav</Start>
                </Wave>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling02.wav</Start>
                </Wave>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling03.wav</Start>
                </Wave>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling04.wav</Start>
                </Wave>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling05.wav</Start>
                </Wave>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling06.wav</Start>
                </Wave>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling07.wav</Start>
                </Wave>
                <Wave Type="D3">
                    <Start>Audio\Wep\gatling08.wav</Start>
                </Wave>
            </Waves>
        </Sound>

        <!-- ===================== Autocannon ===================== -->
        <Sound>
            <Id>
                <TypeId>MyObjectBuilder_AudioDefinition</TypeId>
                <SubtypeId>ArcWepShipAutocannonShot</SubtypeId>
            </Id>
            <Category>SHOT</Category>
            <MaxDistance>200</MaxDistance>
            <PreventSynchronization>1</PreventSynchronization>
            <DistantSounds>
                <DistantSound DistanceCrossfade="20" Distance="200" Sound="JSWepAutocannonShotDist" />
            </DistantSounds>
            <Volume>2</Volume>
            <Waves>
                <Wave Type="D3">
                    <Start>Audio\Wep\autocannon.wav</Start>
                </Wave>
            </Waves>
        </Sound>
        <Sound>
            <Id>
                <TypeId>MyObjectBuilder_AudioDefinition</TypeId>
                <SubtypeId>JSWepAutocannonShotDist</SubtypeId>
            </Id>
            <Category>SHOT</Category>
            <MaxDistance>800</MaxDistance>
            <PreventSynchronization>1</PreventSynchronization>
            <ArcadeFilter>JSDistantMuffle</ArcadeFilter>
            <Volume>1</Volume>
            <Waves>
                <Wave Type="D3">
                    <Start>Audio\Wep\autocannon.wav</Start>
                </Wave>
            </Waves>
        </Sound>

