<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <AudioEffects>
        <!-- Static low-pass used on distant weapon cues so the same wave sounds far away. -->
        <Effect>
            <Id>
                <TypeId>AudioEffectDefinition</TypeId>
                <SubtypeId>JSDistantMuffle</SubtypeId>
            </Id>
            <Sounds>
                <Sound>
                    <SoundEffects>
                        <SoundEffect>
                            <Duration>0</Duration>
                            <Filter>LowPass</Filter>
                            <Frequency>1000</Frequency>
                            <Q>0.7</Q>
                        </SoundEffect>
                    </SoundEffects>
                </Sound>
            </Sounds>
        </Effect>
        <!-- Heavier low-pass for the furthest distance band. -->
        <Effect>
            <Id>
                <TypeId>AudioEffectDefinition</TypeId>
                <SubtypeId>JSFarDistantMuffle</SubtypeId>
            </Id>
            <Sounds>
                <Sound>
                    <SoundEffects>
                        <SoundEffect>
                            <Duration>0</Duration>
                            <Filter>LowPass</Filter>
                            <Frequency>450</Frequency>
                            <Q>0.7</Q>
                        </SoundEffect>
                    </SoundEffects>
                </Sound>
            </Sounds>
        </Effect>
    </AudioEffects>
</Definitions>
