<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <Weapons>
        <Weapon>
            <Id>
                <TypeId>WeaponDefinition</TypeId>
                <SubtypeId>LargeAutocannonTurret</SubtypeId>
            </Id>
            <ProjectileAmmoData RateOfFire="150" ShootSoundName="WepShipAutocannonShot" ShotsInBurst="16" />
            <ReleaseTimeAfterFire>204</ReleaseTimeAfterFire>
            <DeviateShotAngle>0.25</DeviateShotAngle>
            <DeviateShotAngleAiming>0.25</DeviateShotAngleAiming>
            <MuzzleFlashLifeSpan>40</MuzzleFlashLifeSpan>
            <NoAmmoSoundName>WepShipGatlingNoAmmo</NoAmmoSoundName>
            <SecondarySoundName></SecondarySoundName>
            <Effects>
                <Effect Action="Shoot" Dummy="muzzle_projectile_001" Particle="Muzzle_Flash_Autocannon" Loop="true" InstantStop="false" OffsetX="0" OffsetY="0" OffsetZ="-1.2"/>
                <Effect Action="Shoot" Dummy="None" Particle="Smoke_Autocannon" Loop="true" InstantStop="false"
                OffsetX="0.09" OffsetY="-0.04" OffsetZ="-1.8" 
                ParticleBirthStart="1" ParticleBirthMin="1" ParticleBirthMax="2" ParticleBirthDecrease="1" ParticleBirthIncrease="1" />
            </Effects>
            <AmmoMagazines>
                <AmmoMagazine Subtype="AutocannonClip" />
            </AmmoMagazines>
            <ReloadTime>4000</ReloadTime>
        </Weapon>
        <Weapon>
            <Id>
                <TypeId>WeaponDefinition</TypeId>
                <SubtypeId>RailgunTurret</SubtypeId>
            </Id>
            <MissileAmmoData RateOfFire="20" ShootSoundName="WepRailgunLargeShot" FlightSoundName="HeavyShellFlightSound" ShotsInBurst="1" />
            <ReloadTime>59210</ReloadTime>
            <DeviateShotAngle>0</DeviateShotAngle>
            <DeviateShotAngleAiming>0</DeviateShotAngleAiming>
            <NoAmmoSoundName>WepShipRailgunNoAmmo</NoAmmoSoundName>
            <Effects>
                <Effect Action="Shoot" Dummy="muzzle_missile_1" Particle="Muzzle_Flash_RailgunTurret" Loop="false" InstantStop="false" OffsetX="0" OffsetY="0" OffsetZ="-9" DisplayOnlyOnDummyFiring="true" />
            </Effects>
            <AmmoMagazines>
                <AmmoMagazine Subtype="LargeRailgunAmmo" />
            </AmmoMagazines>
        </Weapon>
    </Weapons>
</Definitions>
