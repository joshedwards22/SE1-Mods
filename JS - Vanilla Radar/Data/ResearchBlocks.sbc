<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ResearchBlocks>
        <!-- Same unlock group as the vanilla radio antennas (group 6). -->
        <ResearchBlock xsi:type="ResearchBlock">
            <Id Type="MyObjectBuilder_LargeGatlingTurret" Subtype="Lidar" />
            <UnlockedByGroups>
                <GroupSubtype>6</GroupSubtype>
            </UnlockedByGroups>
        </ResearchBlock>
        <ResearchBlock xsi:type="ResearchBlock">
            <Id Type="MyObjectBuilder_LargeGatlingTurret" Subtype="LidarSmall" />
            <UnlockedByGroups>
                <GroupSubtype>6</GroupSubtype>
            </UnlockedByGroups>
        </ResearchBlock>
    </ResearchBlocks>
</Definitions>
