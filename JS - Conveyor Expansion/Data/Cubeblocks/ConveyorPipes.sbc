        <Model BuildPercentUpperBound="0.66" File="Models\Cubes\large\PipeElbow_BS2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\large\PipeElbow_BS3.mwm" />
      </BuildProgressModels>
